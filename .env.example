PORT=3000
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: token propio para proteger el endpoint si se publica en Internet.
GOOGLE_WEBHOOK_TOKEN=

# Vercel KV (Redis) — necesario para que las suscripciones push persistan en producción.
# Se obtienen automáticamente al vincular una base de datos KV en el dashboard de Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
